/* fmJAML ( pJAML )
   __                _         __  __ _      
  / _|              | |  /\   |  \/  | |     
 | |_ _ __ ___      | | /  \  | \  / | |     
 |  _| '_ ` _ \ _   | |/ /\ \ | |\/| | |     
 | | | | | | | | |__| / ____ \| |  | | |____ 
 |_| |_| |_| |_|\____/_/    \_\_|  |_|______|
                                             
                                             
`code from your keyboard`

**fmJAML** = **F**ile**M**aker **J**SON **A**s a **M**arkdown **L**angauge

fmJAML is a Domain Specific Langauage (DSL) for encoding JSON as a simple, concise, readable string in FileMaker.

The fmJAML function takes an fmJAML text as input and outputs the equivalent JSON.

It was originally created to write fmIDE Action Scripts.

Author: @mrwatson-de
Created: 2026-03-10
Version: 2026-05-05 @mrwatson-de v0.15

Note: Due to CF size limit see fmJAML_changes for rest of the history

*/

/*******************
Process fmJAML lines
*******************/

While (
[

/* input parameter */
¢lines = pFmJAML ;

/* debugging input & outputs */
/* FIXME - Using the modifier keys for log level is a neat trick but a fudge. */
¢debug = Case( not IsEmpty ( $fmJAML_debug ) ; $fmJAML_debug ; Get ( ActiveModifierKeys ) ) ;
$$fmJAML_log = "" ;
$$fmJAML_debug_dtype = "" ;
$$fmJAML_debug_dps = "" ;

¢fmp_version_major = 0 + GetValue ( Substitute ( Get ( ApplicationVersion ) ; "." ; ¶ ) ; 1 ) ;


/* Prepare variables */
$fmJAML_path_prev = "" ;

¢result = "" ;

/* Constants */
¢JSONDate      = 20 ;
¢JSONTime      = 21 ;
¢JSONTimestamp = 22 ;
¢JSONContainer = 23 ;

/*************
FOR EACH ¢line
*************/

/* Ignore the fmjaml shebang line, if present */
¢line_i = 1 + (Left ( ¢lines ; 8 ) = "#!fmjaml") ;
¢line_n = ValueCount ( ¢lines )

]; ¢line_i <= ¢line_n ;[

¢line  = Trim( GetValue ( ¢lines ; ¢line_i ) );

/*********
Split line
**********

into «path»[=[;«dtype_str»;][«expr»]]]
*/

/* ignore comment lines */
¢line  = Case( Left ( ¢line ; 2 ) ≠ "//" ; ¢line ) ;
¢isLineEmpty = IsEmpty( ¢line ) ;

/* split at `=`*/
¢posEquals = Position( ¢line ; "=" ; 1 ; 1 ) ;
$fmJAML_path  = Case( ¢posEquals ; Left( ¢line ; ¢posEquals-1 ) ; ¢line ) ;
¢lineRest = Case( ¢posEquals ; Trim( Right( ¢line ; Length( ¢line ) - ¢posEquals ) ) ) ;

/* DPS */
¢isDps = Left( ¢lineRest ; 1 ) = ";" ; 
¢posDpsEnd   = Case( ¢isDps ; Position ( ¢lineRest & ";" ; ";" ; 2 ; 1 ) ) ;
¢dps = Case ( ¢posDpsEnd ; Trim( Middle ( ¢lineRest ; 2 ; ¢posDpsEnd - 2 ) ) ) ;

/* expr & heredoc */
¢expr  = Trim ( Right ( ¢lineRest ; Length ( ¢lineRest ) - ¢posDpsEnd ) ) ;
¢is_heredoc = Position ( ¢expr ; "===" ; 1 ; 1 ) = 1 ;

/* DEBUG */
If=Case ( ¢debug ≥ 7 ; Let([
    $$fmJAML_debug_dps = ¢dps ;
    $$fmJAML_log = List( $$fmJAML_log ;
    "line:	" & ¢line_i ;
    "- path:	" & $fmJAML_path ;
    Case( ¢posEquals ;
      List ( 
        "- DPS	" & Quote( ¢dps ) ;
        "- value:	" & ¢expr ;
        "- heredoc:	" & ¢is_heredoc ;
      )
    ) ;
    ) ;
EndIf=0];0));


/**********
EXPAND PATH
***********

Support for avoiding key-repetition by using empty keys between dots:

[+].	Show Custom Dialog.message="Hello"
[:].	.title="DEBUG"

becomes

[+].	Show Custom Dialog.message="Hello"
[:].	Show Custom Dialog.title="DEBUG"

…but we must also support indentation:

[+].		Show Custom Dialog.message="Hello"
[:].		.title="DEBUG"

becomes

[+].		Show Custom Dialog.message="Hello"
[:].		Show Custom Dialog.title="DEBUG"

Algorithm:

1. Find the first dot
2. then count further dots (andc array `[`/`]` in the immedaitely following characters, ignoring white space (in ¢dot_count).
3. finally, if there are succedding dots (¢dot_count > 1), replace dots 1…j in the current path 
   with the keys from the previous path between dots 1 and j.

*/

$fmJAML_path_no_ws = Substitute( $fmJAML_path ; [" " ; ""] ; [Char(9) ; ""] ) /*& "."*/ ;
$fmJAML_path = While ([

  ¢pos_no_ws = Position ( $fmJAML_path_no_ws ; "." ; 1 ; 1 ) ;
  ¢dot_count = 1

  ]; Position( ".[]" ; Middle ( $fmJAML_path_no_ws ; ¢pos_no_ws + ¢dot_count ; 1 ) ; 1 ; 1 ) ; [

  ¢dot_count = ¢dot_count + 1

  ];

  Case(
     /* No key inheritance */

    ¢dot_count = 1 ; $fmJAML_path ;

    /*****************
    Hydrate empty keys
    ******************
    
    from previous path

    FIXME
    - Document existing support for minimal delimiters, e.g.
      ```
      [+].Show Custom Dialog.message="Hi"
      [:]..button[+]="Yes"
      [:].         ]="Maybe"
      [:].         ]="No"
      ```
    - Support ['path.with.dots&[co]']
    
    Iterarate over the path parts '..[].'
    */ 

    While(
    [

    /* Starting with (and remembering) the first dot (FIXME: delimiter?)… */
    
    ¢pos = Position ( $fmJAML_path ; "." ; 1 ; 1 ) ;
    ¢pos_prev = Position ( $fmJAML_path_prev ; "." ; 1 ; 1 ) ;
    ¢pos_start = ¢pos ;
    ¢pos_prev_start = ¢pos_prev ;

    /* …FOR EACH succesive delimiter… */

    ¢dot_offset= 2

    ]; ¢dot_offset<= ¢dot_count ;[

    ¢char = Middle( $fmJAML_path_no_ws ; ¢pos_no_ws + ¢dot_offset-1 ; 1 ) ;

    /* Locate the delimiter in the current and previous path */
    
    ¢pos = Position ( $fmJAML_path ; ¢char ; ¢pos+1 ; 1 ) ;
    ¢pos_prev = Position ( $fmJAML_path_prev ; ¢char ; ¢pos_prev+1 ; 1 ) ;

    ¢dot_offset= ¢dot_offset+ 1
    
    ];

    /* Insert the missing keys from the old path into the new path */
    
    /* If the *entirity* of the previous path is being repeated, 
       FIXME - AND if it replacing the entirity of 
       ignore the final "."
    ¢pos_prev_end   = ¢pos_prev_end - Case(
      ¢pos_prev_end = Length( $fmJAML_path_prev ) and
      ¢pos + ¢dot_count = Length( $fmJAML_path_no_ws ) ; 1 );
    ¢pos_prev_end   = ¢pos_prev_end - Case( ¢pos_prev_end = Length( $fmJAML_path_prev ) ; 1 ) ;
    */

    Replace( $fmJAML_path ; ¢pos_start ; ¢pos+1 - ¢pos_start ; Middle ( $fmJAML_path_prev ; ¢pos_prev_start ; ¢pos_prev+1 - ¢pos_prev_start ) )
& Case( ¢debug ; Let(
$$fmJAML_log = List( $$fmJAML_log ;
    "PREV: " & $fmJAML_path_prev ;
    "CURR: " & $fmJAML_path ;
    Middle( $fmJAML_path ; ¢pos_start ; ¢pos+1 - ¢pos_start ) & " ----> " & Middle ( $fmJAML_path_prev ; ¢pos_prev_start ; ¢pos_prev+1 - ¢pos_prev_start )
  ) ;""))

    )

  )

  );

$fmJAML_path = Case( Right( $fmJAML_path ; 1 ) = "." ; Left( $fmJAML_path ; Length( $fmJAML_path ) -1 ) ; $fmJAML_path ) ; 



/**************
Support for [+] and [:] in FileMaker versions < 21
***************
*/

$fmJAML_path = Case( ¢fmp_version_major ≥ 21 ; $fmJAML_path ;

    While (
    [

    ¢resolved_path = $fmJAML_path ;
    ¢pos_plus  = Position ( ¢resolved_path ; "[+]" ; 1 ; 1 ) ;
    ¢pos_colon = Position ( ¢resolved_path ; "[:]" ; 1 ; 1 ) 

    ] ; ¢pos_plus or ¢pos_colon ; [

    ¢pos = Case ( ¢pos_plus and ¢pos_colon ; Min ( ¢pos_plus ; ¢pos_colon ) ; ¢pos_plus + ¢pos_colon ) ;
    ¢array_length  = ValueCount ( JSONListKeys ( ¢result ; Left ( ¢resolved_path ; ¢pos - 1 ) ) ) ;
    ¢index = ¢array_length - ( ¢pos = ¢pos_colon ) ;
    ¢resolved_path = Replace ( ¢resolved_path ; ¢pos + 1 ; 1 ; Max( 0 ; ¢index ) ) ;
    ¢pos_plus  = Position ( ¢resolved_path ; "[+]" ; ¢pos+3 ; 1 ) ;
    ¢pos_colon = Position ( ¢resolved_path ; "[:]" ; ¢pos+3 ; 1 )

    ];

    ¢resolved_path

    )
  ) ;

$fmJAML_path_prev = Case( ¢isLineEmpty ; $fmJAML_path_prev ; $fmJAML_path & "." ) ;  

/******
heredoc
*******

Process value or heredoc
*/

¢value = Case (
    ¢isLineEmpty ; "" ;

    /* no expression -> empty object */
    IsEmpty ( ¢expr ) ; "{}" ; 

    /* heredoc -> read string */
    ¢is_heredoc ; Let(
        [ 
        ¢marker    = ¢expr ;
        ¢pos_start = Length( LeftValues ( ¢lines ; ¢line_i ) )+1 ;
        ¢pos_end   = Position ( ¢lines ; ¢marker ; ¢pos_start ; 1 )
        ];
        Middle( ¢lines ; ¢pos_start ; ¢pos_end - ¢pos_start /* and remove last EOL: */ -1 )
        ) ;

    /* otherwise expression -> evaluate */
      Evaluate ( ¢expr )

  );


/*
Calculate the line-increment value based on the number of lines consumed by the heredoc.
This is required for the next section where the dtype_str needs to drop the key if an empty condition (=EOF) is reached
*/
¢line_inc     = 1 + Case( ¢is_heredoc ; 1+ValueCount( ¢value ) ) ;


/************
;«dtype_str»;
*************

Process ;«dtype_str»;
*/

$fmJAML_val = ¢value ;
$fmJAML_dtype = "" ;
$fmJAML_sticky_op = "" ;
$fmJAML_context = "" ;
$fmJAML_clause_empty = "" ;
$fmJAML_present = "" ;
$fmJAML_test = "" ;
$fmJAML_skip = "" ;

¢parse_dps = While (
  [

  /*************
  FOR EACH ¢char
  **************

  in the ¢dps, at least until dropped…
  */

  ¢dpsPos = 1 ;
  ¢dpsLength = Length( ¢dps )

  ]; ¢dpsPos <= ¢dpsLength+1 and not IsEmpty ( $fmJAML_path );[

  ¢char = Middle ( ¢dps ; ¢dpsPos ; 1 ) ;
  $fmJAML_chars_read = 1 ;

  ¢eof = ¢dpsPos > ¢dpsLength ;
  ¢eoClause = ¢eof or Position ( "?-:," ; ¢char ; 1 ; 1 ) ;

  /* DEBUG fmJAML */
  If=Case ( ¢debug ≥ 7 ; Let([
      $$fmJAML_log = List( $$fmJAML_log ;
      "DPS[" & ¢dpsPos & "]: "  & Quote ( ¢char ) & Case( ¢eof ; " («EOF»)" );
      "- $fmJAML_dtype: "        & $fmJAML_dtype ;
      "- $fmJAML_present: "      & Quote ( $fmJAML_present ) ;
      "- $fmJAML_test: "         & Quote ( $fmJAML_test ) ;
      "- $fmJAML_skip: "         & Quote ( $fmJAML_skip ) ;
      "- $fmJAML_clause_empty: " & Quote ( $fmJAML_clause_empty ) ;
      "- $fmJAML_sticky_op: "    & Quote ( $fmJAML_sticky_op ) ;
      "- $fmJAML_context: "      & Quote ( $fmJAML_context ) ;
      "- $fmJAML_path: "         & Quote ( $fmJAML_path ) ;
      "- $fmJAML_val: "          & Quote ( $fmJAML_val ) ;
      ) ;
  EndIf=0];0));

  /*****************
  Lazy data coercion
  ******************

  Convert the value to the target data-type, but first when a processing operator (`!`/`?`/`-`) is encountered
  */
  ¢performLazyCoercing = Case(
    ¢eof or IsEmpty ( $fmJAML_dtype ) ; "" ;
    Position ( "!?-" ; ¢char ; 1 ; 1 ) = 0 ; "" ;
    $fmJAML_dtype = JSONString     ; Let( $fmJAML_val = GetAsText      ( $fmJAML_val )      ; "" ) ;
    $fmJAML_dtype = JSONNumber     ; Let( $fmJAML_val = GetAsNumber    ( $fmJAML_val )      ; "" ) ;
    $fmJAML_dtype = JSONBoolean    ; Let( $fmJAML_val = GetAsBoolean   ( $fmJAML_val )      ; "" ) ;
    $fmJAML_dtype = ¢JSONDate      ; Let( $fmJAML_val = GetAsDate      ( $fmJAML_val )      ; "" ) ;
    $fmJAML_dtype = ¢JSONTime      ; Let( $fmJAML_val = GetAsTime      ( $fmJAML_val )      ; "" ) ;
    $fmJAML_dtype = ¢JSONTimestamp ; Let( $fmJAML_val = GetAsTimestamp ( $fmJAML_val )      ; "" ) ;
    $fmJAML_dtype = JSONArray      ; Let( $fmJAML_val = JSONGetElement ( $fmJAML_val ; "" ) ; "" ) ;
    $fmJAML_dtype = JSONObject     ; Let( $fmJAML_val = JSONGetElement ( $fmJAML_val ; "" ) ; "" ) ;
    $fmJAML_dtype = JSONRaw        ; Let( $fmJAML_val = JSONGetElement ( $fmJAML_val ; "" ) ; "" ) ;
  );

  /*************
  Parse operator
  **************

  Switch statement to process the encountered operator
  */
  ¢parseNextOp = Case(

    /* SWITCH ( ¢char ) */


    /* Lazily drop path, if necessary, which is when… */
    ¢eoClause and $fmJAML_clause_empty and /* …completed, empty (or missing) clause and… */ 
    Case( $fmJAML_present ;
      /* …value present and … explicitly empty presence clause: */ 
      $fmJAML_context = "?" and ¢char = ":"    /* value + "?💢:" -> */
      or
      $fmJAML_context = "-:" ;                 /* value + "-:💢" -> */

      /* …value empty and… */
      $fmJAML_context = "?" and ¢char ≠ ":"    /* empty + "?💢" (implicit) -> */
      or
      $fmJAML_context = "?:"                   /* empty + "?:💢" (explicit) -> */
    )
    ; Let( $fmJAML_path = "" ; "" ) ;          /* -> drop value + path! */ 

    /* Ignore EOF or white space */

    ¢eof or
    ¢char = " " or
    ¢char = Char(9) ; "" ;

    /* Process end-skip chars (`:` / `,`) *before* processing any skipping */

    ¢char = "," ; Let ([/* End conditional scope */
                        $fmJAML_present = "" ;
                        $fmJAML_test = "" ;
                        $fmJAML_skip = "" ;
                        $fmJAML_clause_empty = "" ;
                        $fmJAML_context = "" ;
                        $fmJAML_sticky_op = ""
                       ]; "" ) ;
    ¢char = ":" ; Let ([/* otherwise clause */
                        $fmJAML_context = Case(
                          $fmJAML_context = "?" ; "?:" ;
                          $fmJAML_context = "-" ; "-:" ;
                          $fmJAML_context
                          ) ;
                        $fmJAML_skip = $fmJAML_test ;
                        $fmJAML_clause_empty  = 1 ;
                        $fmJAML_sticky_op = ""
                       ]  ; "" ) ;

    /********
    '«value»'
    *********

    Read the entire apostrophe-string, then either 
    - if skipping             -> ignore it, otherwise (mark the current clause as not empty and…)
    - if not-value (`!'…'`)   -> remove the value if present or
    - if normal value (`'…'`) -> set the value to the string.
    */
    ¢char = "'" ; Let([¢dpsValueEnd = Position ( ¢dps & "'" ; "'" ; ¢dpsPos+1 ; 1 ) ;
                       $fmJAML_chars_read = ¢dpsValueEnd+1 - ¢dpsPos ;
                       ¢dpsValue = Middle( ¢dps ; ¢dpsPos+1 ; $fmJAML_chars_read - 2 ) ;


                       /* Interpret a pilcrow `\¶` as an EOL `¶`  */
                       ¢dpsValue = Substitute( ¢dpsValue ; "\¶" ; ¶ ) ;

                        /* Simply ignore the value if skipping…  */

                        If=Case ( not $fmJAML_skip ; Let([

                            /* …otherwise, mark clause as not empty and process the value:  */
                            $fmJAML_clause_empty = "" ;
                            $fmJAML_val = Case(

                              /* If not-text operation (!'…') -> Remove value if present */
                              $fmJAML_sticky_op = "!" ; Let([

                                If=Case ( $fmJAML_val ≠ ¢dpsValue and ¢debug ≥ 7 ; Let([
                                     $$fmJAML_log = List( $$fmJAML_log ;
                                         "VALUE DROPPED: '" & $fmJAML_val & "'" ;
                                       ) ;
                                EndIf=0];""))

                                ];

                                /* REMOVE value if present // FIXME equal or exact? */
                                Case ( $fmJAML_val ≠ ¢dpsValue ; $fmJAML_val )

                                ) ;

                              /* If eol operation (¶'…') -> Replace EOLs in value with the text */
                              $fmJAML_sticky_op = "¶" ; Let([

                                $fmJAML_sticky_op = "" ;

                                vResult = Substitute ( $fmJAML_val
                                                     ; [Char(13) & Char(10);¶]       /* CRLF -> CR */
                                                     ; [Char(10);¶]                  /* LF -> CR */
                                                     ; [¶ ; ¢dpsValue] /* CR -> replacement */
                                                     ) ;

                                /* DEBUG fmJAML */
                                If=Case ( ¢debug ≥ 7 ; Let([
                                     $$fmJAML_log = List( $$fmJAML_log ;
                                         "EOLs " & Case( IsEmpty ( ¢dpsValue ) ; "REMOVED" ; "REPLACED with '" & ¢dpsValue & "'") & 
                                         ": '" & vResult & "'" ;
                                       ) ;
                                EndIf=0];""))
                                ];

                                vResult

                                ) ;

                              /* else divide operation  (/'…') -> Divide the value by the text */
                              $fmJAML_sticky_op = "/" ; Let([

                                $fmJAML_sticky_op = "" ;

                                vResult = $fmJAML_val / ¢dpsValue ;

                                /* DEBUG fmJAML */
                                If=Case ( ¢debug ≥ 7 ; Let([
                                     $$fmJAML_log = List( $$fmJAML_log ;
                                         "Divide: " & $fmJAML_val &" / " & ¢dpsValue & " -> " & vResult ;
                                       ) ;
                                EndIf=0];""))
                                ];

                                vResult

                                ) ;



                              /* else set-text operation ('…') -> Set value */
                                ¢dpsValue
                              );

                        EndIf=0];0))
                      ]; "" ) ;

    /* Process skip: skip any other simple operators (and continue skipping up to any of the above operators or <EOF>) */

    $fmJAML_skip ; Let([ /* DEBUG fmJAML */
                        If=Case ( ¢debug ≥ 8 ; Let([
                          $$fmJAML_log = List( $$fmJAML_log ;
                                         "SKIPPED: '" & ¢char & "'" ;
                                         ) ;
                        EndIf=0];""))
                      ];"") ;

    /* ANY other active character indicates the clause is not empty */
    $fmJAML_clause_empty and Let( $fmJAML_clause_empty = "" ; False ) ; "" ;


    /* Perform the next operator (using Choose for speed)… */
    Choose ( Position( "TNBAOUDIMR*!\¶/?" ; Substitute( ¢char ; "-" ; "?" ) ; 1 ; 1 ) ;

    /* ignore unknown char */ "" ; 

    /* Process data type */

    /* "T" ;*/ Let( $fmJAML_dtype = JSONString  ; "" ) ;
    /* "N" ;*/ Let( $fmJAML_dtype = JSONNumber  ; "" ) ;
    /* "B" ;*/ Let( $fmJAML_dtype = JSONBoolean ; "" ) ;
    /* "A" ;*/ Let( $fmJAML_dtype = JSONArray   ; "" ) ;
    /* "O" ;*/ Let( $fmJAML_dtype = JSONObject  ; "" ) ;
    /* "U" ;*/ Let( $fmJAML_dtype = JSONNull    ; "" ) ;
    /* "D" ;*/ Let( $fmJAML_dtype = ¢JSONDate   ; "" ) ;
    /* "I" ;*/ Let( $fmJAML_dtype = ¢JSONTime   ; "" ) ;
    /* "M" ;*/ Let( $fmJAML_dtype = ¢JSONTimestamp ; "" ) ;
    /* "R" ;*/ Let( $fmJAML_dtype = ¢JSONContainer ;  "" ) ;

    /* Process white space operators */

    /* "*" ;*/ Let([$fmJAML_chars_read = While( ¢counter = 1 ; Middle ( ¢dps ; ¢dpsPos + ¢counter ; 1 )="*" ; ¢counter = ¢counter + 1 ; ¢counter ) ;
                    $fmJAML_val = Case(

                      /* "*****" = Trim/Format JSON */
                      $fmJAML_chars_read ≥ 5 ;
                        JSONFormatElements ( $fmJAML_val ) ;

                      /* "****" = Trim/Compact JSON */
                      $fmJAML_chars_read = 4 ;
                        JSONGetElement ( $fmJAML_val ; "" ) ;

                      /* "*" = simple trim */
                      $fmJAML_chars_read = 1 ;
                        Trim( $fmJAML_val ) ;

                      /* "*…" complex trim */
                        Let(
                        [

                        /* "**" = horizontal trim (space and tab) */
                        /* "***" = vertical trim (and EOL) */
                        ¢temp  = Case( 
                          $fmJAML_chars_read = 2 ; 
                            Substitute( $fmJAML_val ; [" ";""] ; [Char(9);""] ) ;
                            Substitute( $fmJAML_val ; [" ";""] ; [Char(9);""] ; [¶;""] ; [Char(10);""] )
                          ) ;

                        /* trim everything outside the first and last characters */
                        ¢posChar1 = Position ( $fmJAML_val ; Left( ¢temp ; 1 ) ; 1 ; 1 ) ;
                        ¢posCharN = Position ( $fmJAML_val ; Right( ¢temp ; 1 ) ; Length ( $fmJAML_val ) ; -1 )

                        ];

                        Case( not IsEmpty ( ¢temp ) ; Middle ( $fmJAML_val ; ¢posChar1 ; ¢posCharN+1 - ¢posChar1 ) )
                        
                        )
                      )
                   ]; "" ) ;
    /* "!" ;*/ Let( $fmJAML_sticky_op = "!" ; "" );

    /* Process EOL operator */

    /* "\¶" ;*/ Let([  If=Case ( Middle ( ¢dps ; ¢dpsPos + 1 ; 1 )="1" ; Let([
                          $fmJAML_chars_read = $fmJAML_chars_read + 1 ;
                          $fmJAML_val = GetValue( $fmJAML_val ; 1 ) ;
                        Else=0];"") ; Let([
                          $fmJAML_sticky_op = "¶"  ;
                        EndIf=0];"")) ;

                          $fmJAML_sticky_op = Case( Middle ( ¢dps ; ¢dpsPos + 1 ; 1 )="1" ; "" ; $fmJAML_sticky_op )
                      ]; "" ) ;

    /* Process Divide operator `/` */

    /* "/" ;*/ Let( $fmJAML_sticky_op = "/" ; "" ) ;

    /* 
     * Process conditional operators:
     *
     * - `?` optional operator // tests for presense // not IsEmpty ( «value» )
     * - `-` mapping operator  // tests for absense  // IsEmpty ( «value» )
     * 
     */
    /* "?" or 
       "-" */
    Let ([$fmJAML_context       = ¢char ;
          $fmJAML_present       = not IsEmpty ( $fmJAML_val );  
          $fmJAML_test          = $fmJAML_present xor (¢char = "-");  
          $fmJAML_skip          = not $fmJAML_test ;
          $fmJAML_clause_empty  = 1 ;
          $fmJAML_sticky_op     = ""
         ]; "" )
    ) /* End Choose ( parseNextOp ) */

  ); /* End SWITCH ( parseNextOp ) */

  /*********
  NEXT ¢char
  **********

  …skipping multiple characters read, if necessary
  */
  ¢dpsPos = ¢dpsPos + $fmJAML_chars_read

  ];""); /* End parseDTS */


/*****************
Default data types
*****************/

$fmJAML_dtype = Case(
    not IsEmpty ( $fmJAML_dtype ) ; $fmJAML_dtype ;
    ¢posEquals = 0    ; JSONObject ;
    IsEmpty ( ¢expr ) ; JSONNull ;
                        JSONString
  );

$$fmJAML_debug_dtype = List( $$fmJAML_debug_dtype ; "line " & ¢line & ": " & $fmJAML_dtype ) ;




/******************
Output line to JSON
******************/

/* DEBUG fmJAML */
If=Case ( ¢debug ≥ 6 ; Let([
    $$fmJAML_log = List( $$fmJAML_log ;
    "-> $fmJAML_path:	" & Quote ( $fmJAML_path ) ;
    Case( IsEmpty($fmJAML_path ) ; "PATH DROPPED" ) ;
   ) ;
EndIf=0];0));

¢result = Case (

    /* DROP line, if no path */
    IsEmpty( $fmJAML_path ) ;
      ¢result ;

    /* Set element based on the calculated path value and data type */
      JSONSetElement ( ¢result ; $fmJAML_path ; 
        Case(
          /* Encode Date/Time/Timestamp using ISO 8601 (RFC 3339) without timezone (YYYY-MM-DD / HH:MM:SS / YYYY-MM-DDTHH:MM:SS) */
          $fmJAML_dtype = ¢JSONDate ;      Year  ( $fmJAML_val )
               & SerialIncrement ( "-00" ; Month ( $fmJAML_val ) )
               & SerialIncrement ( "-00" ; Day   ( $fmJAML_val ) ) ;
          $fmJAML_dtype = ¢JSONTime ;
                 SerialIncrement ( "00"  ; Hour    ( $fmJAML_val ) )
               & SerialIncrement ( ":00" ; Minute  ( $fmJAML_val ) )
               & SerialIncrement ( ":00" ; Seconds ( $fmJAML_val ) ) ;
          $fmJAML_dtype = ¢JSONTimestamp ; Year    ( $fmJAML_val )
               & SerialIncrement ( "-00" ; Month   ( $fmJAML_val ) )
               & SerialIncrement ( "-00" ; Day     ( $fmJAML_val ) )
               & SerialIncrement ( "T00" ; Hour    ( $fmJAML_val ) )
               & SerialIncrement ( ":00" ; Minute  ( $fmJAML_val ) )
               & SerialIncrement ( ":00" ; Seconds ( $fmJAML_val ) ) ;
          /* Encode container using RFC 4648, above all, no problematic line breaks! */
          $fmJAML_dtype = ¢JSONContainer ; JSONSetElement ( "{}"
                           ;["file.name" ; GetContainerAttribute ( $fmJAML_val ; "filename" ) ; JSONString]
                           ;["file.data" ; Base64EncodeRFC ( 4648 ; $fmJAML_val ) ; JSONString]
                           ) ;
            $fmJAML_val
        ) ;
        Case(
          $fmJAML_dtype = ¢JSONDate      ; JSONString ;
          $fmJAML_dtype = ¢JSONTime      ; JSONString ;
          $fmJAML_dtype = ¢JSONTimestamp ; JSONString ;
          $fmJAML_dtype = ¢JSONContainer ; JSONObject ;
            $fmJAML_dtype
        ) )

  );

//vDEBUG = Let( $$fmJAML_logDetails = Case( ¢debug ; List( $$fmJAML_logDetails ; ¢result & "¶:::::::") ) ; "" ) ;


/*********
NEXT ¢line
**********

skipping multi-line heredocs, as necessary
*/

¢line_i = ¢line_i + 1 + Case( ¢is_heredoc ; 1+ValueCount( ¢value ) ) ;

$$fmJAML_log = Case( ¢debug ≥ 9 ; List( $$fmJAML_log ; "¢result after line " & (¢line_i-1) & ": " & Quote( ¢result ) & "¶=========" ) )

];  

/************
RETURN result
*************

…tidying vars before returning the actions array
*/

Let(
[
$fmJAML_chars_read = "" ;
$fmJAML_dtype      = "" ;
$fmJAML_present    = "" ;
$fmJAML_test       = "" ;
$fmJAML_skip       = "" ;
$fmJAML_sticky_op  = "" ;
$fmJAML_context    = "" ;
$fmJAML_path       = "" ;
$fmJAML_path_prev  = "" ;
$fmJAML_path_no_ws = "" ;
$fmJAML_val      = ""
];

¢result

)

)